{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "env": {
    "REACT_APP_API_URL": "/api",
    "REACT_APP_API_BASE_URL": "https://lern-me-backend.onrender.com"
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://lern-me-backend.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://lern-me-backend.onrender.com/uploads/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
